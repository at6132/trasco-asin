# Keepa (required for full process)
KEEPA_API_KEY=
KEEPA_DOMAIN=1

# Anthropic — primary: Claude Haiku for column/header mapping (largest sheet + CSV)
ANTHROPIC_API_KEY=
# Examples: claude-3-5-haiku-20241022, claude-haiku-4-5-20251001
HAIKU_MODEL=claude-3-5-haiku-20241022

# Ollama / Gemma — optional. On Railway (Haiku-only) set all three to false unless you run Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:27b
USE_OLLAMA_ASIN_VALIDATE=false
USE_OLLAMA_RESOLVER_GEMMA=false
USE_OLLAMA_SHEET_DOMAIN=false
OLLAMA_ASIN_VALIDATE_TIMEOUT_SEC=120

# CORS — comma-separated allowed browser origins (scheme + host, no path). Production should use https://.
# Example: https://trasco-web-production.up.railway.app
# If unset, only http://localhost:3000 and http://127.0.0.1:3000 are allowed.
CORS_ALLOW_ORIGINS=

# Optional persistence on Railway: mount a volume and set absolute paths (see RAILWAY.md).
# TRASCO_PROCESS_HISTORY_DIR=
# TRASCO_CACHE_DB=
