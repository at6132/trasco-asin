# Keepa (required for full process)
KEEPA_API_KEY=
KEEPA_DOMAIN=1

# Anthropic — column/header mapping on the largest sheet (and CSV) when Ollama is off or unreachable
ANTHROPIC_API_KEY=
# Examples: claude-3-5-haiku-20241022, claude-haiku-4-5-20251001
HAIKU_MODEL=claude-3-5-haiku-20241022

# Ollama (optional on Railway — Gemma for headers if reachable, SKU pick, sheet domain, ASIN validate)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:27b
USE_OLLAMA_ASIN_VALIDATE=true
USE_OLLAMA_RESOLVER_GEMMA=true
USE_OLLAMA_SHEET_DOMAIN=true
OLLAMA_ASIN_VALIDATE_TIMEOUT_SEC=120

# CORS — comma-separated origins (your Next.js public URL). Required for browser calls from production.
# Example: https://trasco-frontend-production.up.railway.app
CORS_ALLOW_ORIGINS=

# SQLite cache + process history (defaults under repo; override for volumes)
TRASCO_PROCESS_HISTORY_DIR=
